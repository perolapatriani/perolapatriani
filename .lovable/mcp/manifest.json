{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://atmsbgapyenaikbpjtuz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "perola-patriani-mcp",
      "version": "0.1.0",
      "title": "Pérola Patriani · MCP"
    },
    "tools": [
      {
        "name": "list_properties",
        "title": "Listar imóveis",
        "description": "Lista imóveis publicados no site (título, bairro, quartos, preço, slug).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Quantos imóveis retornar"
            },
            "neighborhood": {
              "type": "string",
              "description": "Filtrar por bairro (contém)"
            },
            "min_bedrooms": {
              "type": "integer",
              "description": "Mínimo de quartos"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_crm_contacts",
        "title": "Listar contatos do CRM",
        "description": "Lista contatos do CRM (requer permissão de admin). Filtra por busca, origem ou status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "search": {
              "type": "string",
              "description": "Busca por nome, telefone ou e-mail"
            },
            "status": {
              "type": "string",
              "description": "Filtrar por status"
            },
            "source": {
              "type": "string",
              "description": "Filtrar por origem (source_last)"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_crm_contact",
        "title": "Detalhes de contato CRM",
        "description": "Retorna o contato e sua linha do tempo de eventos (formulários, notas, interações).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "contact_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do contato no CRM"
            },
            "events_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          "required": [
            "contact_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_crm_note",
        "title": "Adicionar nota ao CRM",
        "description": "Registra uma nota interna na linha do tempo de um contato do CRM.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "contact_id": {
              "type": "string",
              "format": "uuid"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Conteúdo da nota"
            }
          },
          "required": [
            "contact_id",
            "note"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
